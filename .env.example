# Copy to .env and fill in your own bot token. Never commit the real .env.
NUHUH_DISCORD_TOKEN=
# Public source for the running copy. Modified forks must publish their version
# and change this URL; a commit or release URL is preferable for hosted copies.
NUHUH_SOURCE_URL=https://github.com/covesoft/Dont-Ping-Me

NUHUH_DETAILS_URL=https://github.com/covesoft/Dont-Ping-Me

# Comma-separated Discord user IDs with access to guilds/size owner reports.
# Leave empty to disable owner commands. Reports appear in the invoking channel.
OWNER_IDS=
